# ForgeOS / FitTracker AI Backend Production Environment Configuration Template

# Server Port (Render dynamically supplies PORT in production)
PORT=5000
NODE_ENV=production

# Frontend Client URL(s) allowed by CORS
# Comma-separated if multiple domains exist (e.g. Vercel deployment & custom domain)
FRONTEND_URL=https://<VERCEL-FRONTEND-DOMAIN>.vercel.app
CLIENT_URL=https://<VERCEL-FRONTEND-DOMAIN>.vercel.app,http://localhost:5173,http://localhost:8080,http://localhost:3000

# Backend Public API URL
API_BASE_URL=https://<RENDER-BACKEND-DOMAIN>.onrender.com/api

# Database Connection Strings (MongoDB Atlas recommended for production)
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/fittrack?retryWrites=true&w=majority

# Security & Secrets (Server-side ONLY - Never expose to Vercel/Browser bundle)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
COOKIE_SECRET=your_cookie_secret_key_here
SESSION_SECRET=your_session_secret_key_here

# Nodemailer / SMTP Email Delivery Configuration
EMAIL_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=FitTracker AI
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# OAuth Configuration (Server-side secrets)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
MAX_VERIFY_ATTEMPTS=5
MAX_RESEND_PER_HOUR=3
