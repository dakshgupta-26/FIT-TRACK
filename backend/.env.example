# =============================================================================
# FitTrack Backend Environment Configuration Example
# =============================================================================

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/fittrack

# Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend URL (For email links & CORS)
# In Local Development: http://localhost:3000 or http://localhost:5173
# In Production (Render): https://<your-actual-vercel-app>.vercel.app
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Mailjet Transactional Email API v3.1 Configuration (SERVER-SIDE ONLY)
# =============================================================================
# NEVER prefix with NEXT_PUBLIC_
# NEVER expose to client/browser code
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=FitTrack

# Alternative supported variable names:
# MJ_APIKEY_PUBLIC=
# MJ_APIKEY_PRIVATE=
# MAIL_FROM_EMAIL=
# MAIL_FROM_NAME=FitTrack

# Optional: Set to true to test API payloads without sending live emails
# MJ_SANDBOX_MODE=false
