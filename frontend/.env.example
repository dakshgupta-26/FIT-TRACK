# ForgeOS / FitTracker AI Frontend Environment Configuration Template

# Production Render Backend API URL (Must end with /api or domain root)
# Example Production: NEXT_PUBLIC_API_URL=https://fit-track-backend.onrender.com/api
# Example Local Dev:  NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_API_URL=https://<RENDER-BACKEND-DOMAIN>.onrender.com/api

# Production Frontend Web Application URL
# Example Production: NEXT_PUBLIC_APP_URL=https://forgeos-fittrack.vercel.app
# Example Local Dev:  NEXT_PUBLIC_APP_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=https://<VERCEL-FRONTEND-DOMAIN>.vercel.app

# Optional WebSocket URL (For Real-time Features)
NEXT_PUBLIC_WS_URL=wss://<RENDER-BACKEND-DOMAIN>.onrender.com

# AI Recommender Microservice URL (Optional Python Flask Server)
# Example Production: NEXT_PUBLIC_RECOMMENDER_URL=https://fit-track-ml.onrender.com
# Example Local Dev:  NEXT_PUBLIC_RECOMMENDER_URL=http://localhost:8000
NEXT_PUBLIC_RECOMMENDER_URL=http://localhost:8000

# Legacy Vite Environment Variables (Supported via Vite envPrefix)
VITE_API_URL=http://localhost:5000/api
VITE_APP_URL=http://localhost:8080
VITE_RECOMMENDER_URL=http://localhost:8000
